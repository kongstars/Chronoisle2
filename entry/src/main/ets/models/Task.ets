
import { GoalCategory } from './Goal';

// 任务状态枚举
export enum TaskStatus {
  PENDING = 'pending',
  COMPLETED = 'completed'
}

export enum TaskPriority {
  HIGH = 'high',
  NORMAL = 'normal',
  LOW = 'low'
}

export interface Subtask {
  id: string;
  title: string;
  isCompleted: boolean;
}
// 任务纯数据接口（用于序列化）
export interface TaskData {
  id: string;
  title: string;
  description: string;
  goalId: string;
  goalTitle: string;
  reminderId?: string;
  reminderTitle?: string;
  isReminderAutoGenerated?: boolean;
  reminderOccurrenceTime?: number;
  krId?: string;
  krTitle?: string;
  dueDate?: number;
  dueTime?: string; // HH:mm 格式，表示计划完成时间的时分部分
  priority: TaskPriority;
  status: TaskStatus;
  createdAt: number;
  completedAt?: number;
  updatedAt: number;
  isPinned?: boolean;
  pomodoroCount?: number;
  category?: GoalCategory;
  subtasks?: Subtask[];
  isImportant?: boolean;
  estimatedHours?: number;
  aiGenerated?: boolean;
  delayCount?: number;
}
// 任务模型
export class Task {
  id: string;
  title: string;
  description: string;
  goalId: string;
  goalTitle: string;
  reminderId?: string;
  reminderTitle?: string;
  isReminderAutoGenerated: boolean;
  reminderOccurrenceTime?: number;
  krId?: string;
  krTitle?: string;
  dueDate?: number;
  dueTime?: string; // HH:mm 格式
  priority: TaskPriority;
  status: TaskStatus;
  createdAt: number;
  completedAt?: number;
  updatedAt: number;
  isPinned: boolean;
  pomodoroCount: number;
  category?: GoalCategory;
  subtasks: Subtask[];
  isImportant: boolean;
  estimatedHours?: number;
  aiGenerated?: boolean;
  delayCount?: number;
  constructor(title: string, goalId: string, goalTitle: string, category?: GoalCategory) {
    this.id = this.generateId();
    this.title = title;
    this.description = '';
    this.goalId = goalId;
    this.goalTitle = goalTitle;
    this.reminderId = undefined;
    this.reminderTitle = undefined;
    this.isReminderAutoGenerated = false;
    this.reminderOccurrenceTime = undefined;
    this.krId = undefined;
    this.krTitle = undefined;
    this.dueDate = undefined;
    this.dueTime = undefined;
    this.priority = TaskPriority.NORMAL;
    this.status = TaskStatus.PENDING;
    this.createdAt = Date.now();
    this.completedAt = undefined;
    this.updatedAt = Date.now();
    this.isPinned = false;
    this.pomodoroCount = 0;
    this.category = category;
    this.subtasks = [];
    this.isImportant = false;
    this.estimatedHours = undefined;
    this.aiGenerated = false;
    this.delayCount = 0;
  }

  private generateId(): string {
    return 'task_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
  }

  complete(): void {
    this.status = TaskStatus.COMPLETED;
    this.completedAt = Date.now();
    this.updatedAt = Date.now();
  }

  uncomplete(): void {
    this.status = TaskStatus.PENDING;
    this.completedAt = undefined;
    this.updatedAt = Date.now();
  }
  
  // 计算精确的逾期截止时间戳
  getEffectiveDueTimestamp(): number | undefined {
    if (this.dueDate === undefined) return undefined;
    if (this.dueTime) {
      // 有设置时分，精确到分钟
      const parts = this.dueTime.split(':');
      const hours = parseInt(parts[0]) || 0;
      const minutes = parseInt(parts[1]) || 0;
      const date = new Date(this.dueDate);
      date.setHours(hours, minutes, 59, 999);
      return date.getTime();
    } else {
      // 未设置时分，以当天结束为逾期界限
      const date = new Date(this.dueDate);
      date.setHours(23, 59, 59, 999);
      return date.getTime();
    }
  }

  // 计算是否逾期
  get isOverdue(): boolean {
    const effectiveTimestamp = this.getEffectiveDueTimestamp();
    return effectiveTimestamp !== undefined && effectiveTimestamp < Date.now() && this.status !== TaskStatus.COMPLETED;
  }
  
  // 获取创建时间（字符串格式）
  get createTime(): string {
    const date = new Date(this.createdAt);
    return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')}`;
  }
  
  // 获取截止时间（字符串格式）
  get deadline(): string {
    if (this.dueDate === undefined) return '';
    const date = new Date(this.dueDate);
    const dateStr = `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')}`;
    if (this.dueTime) {
      return `${dateStr} ${this.dueTime}`;
    }
    return dateStr;
  }
  // 从 JSON 恢复为 Task 实例（解决反序列化后方法丢失的问题）
  static fromJSON(json: TaskData): Task {
    const task: Task = new Task(json.title, json.goalId, json.goalTitle, json.category);
    task.id = json.id;
    task.description = json.description;
    task.reminderId = json.reminderId;
    task.reminderTitle = json.reminderTitle;
    task.isReminderAutoGenerated = json.isReminderAutoGenerated || false;
    task.reminderOccurrenceTime = json.reminderOccurrenceTime;
    task.krId = json.krId;
    task.krTitle = json.krTitle;
    task.dueDate = json.dueDate;
    task.dueTime = json.dueTime;
    task.priority = json.priority || TaskPriority.NORMAL; // 兼容旧数据
    task.status = json.status === TaskStatus.COMPLETED ? TaskStatus.COMPLETED : TaskStatus.PENDING;
    task.createdAt = json.createdAt;
    task.completedAt = json.completedAt;
    task.updatedAt = json.updatedAt;
    task.isPinned = json.isPinned || false;
    task.pomodoroCount = json.pomodoroCount || 0;
    task.subtasks = json.subtasks || [];
    task.isImportant = json.isImportant || false;
    task.estimatedHours = json.estimatedHours;
    task.aiGenerated = json.aiGenerated || false;
    task.delayCount = json.delayCount || 0;
    return task;
  }
}
