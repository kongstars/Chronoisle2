import { CounterUnit, DayEvent, DayEventType, ReminderRule, ReminderType } from '../models/DayEvent';
import { Task, TaskStatus } from '../models/Task';
import { addDays, endOfDay, formatDayEventDate, formatDayEventTime, getCounterTargetDate, getDayEventOccurrenceTimeOnDate, getReminderSummary, startOfDay } from '../common/DayEventUtils';

export interface ReminderPeriodProgress {
  label: string;
  completed: number;
  target: number;
}
export interface ReminderTaskPlan {
  occurrenceTime: number;
  dueDate: number;
  summary: string;
}

export interface ReminderCompletionCandidate {
  occurrenceTime: number;
  task?: Task;
}

export interface PeriodRange {
  start: number;
  end: number;
  label: string;
}

function applyRuleTime(dateOnly: number, rule: ReminderRule): number {
  const date = new Date(startOfDay(dateOnly));
  date.setHours(rule.hour !== undefined ? rule.hour : 9, rule.minute !== undefined ? rule.minute : 0, 0, 0);
  return date.getTime();
}
function getCurrentPeriodRange(rule: ReminderRule, referenceTime: number): PeriodRange | null {
  const currentDay = startOfDay(referenceTime);

  if (rule.type === ReminderType.HABIT_WEEKLY_TARGET) {
    const date = new Date(currentDay);
    const weekday = date.getDay();
    const offset = weekday === 0 ? 6 : weekday - 1;
    const start = addDays(currentDay, -offset);
    const end = endOfDay(addDays(start, 6));
    return {
      start,
      end,
      label: '本周'
    };
  }

  if (rule.type === ReminderType.HABIT_MONTHLY_TARGET) {
    const date = new Date(currentDay);
    const start = new Date(date.getFullYear(), date.getMonth(), 1).getTime();
    const end = endOfDay(new Date(date.getFullYear(), date.getMonth() + 1, 0).getTime());
    return {
      start,
      end,
      label: '本月'
    };
  }

  return null;
}

function getCompletedReminderTasks(tasks: Task[], eventId: string): Task[] {
  return tasks.filter((task: Task) => {
    return task.reminderId === eventId && task.status === TaskStatus.COMPLETED && task.completedAt !== undefined;
  });
}

function getCompletedCountInRange(tasks: Task[], eventId: string, start: number, end: number): number {
  return getCompletedReminderTasks(tasks, eventId).filter((task: Task) => {
    const completedAt = task.completedAt || 0;
    return completedAt >= start && completedAt <= end;
  }).length;
}

function getLastCompletedAutoOccurrence(tasks: Task[], eventId: string): number | undefined {
  const completedAutoTasks = tasks
    .filter((task: Task) => {
      return task.reminderId === eventId &&
        task.isReminderAutoGenerated &&
        task.status === TaskStatus.COMPLETED &&
        task.reminderOccurrenceTime !== undefined;
    })
    .sort((first: Task, second: Task) => {
      return (second.reminderOccurrenceTime || 0) - (first.reminderOccurrenceTime || 0);
    });

  return completedAutoTasks[0]?.reminderOccurrenceTime;
}

function getPendingReminderTasks(tasks: Task[], eventId: string): Task[] {
  return tasks
    .filter((task: Task) => {
      return task.reminderId === eventId &&
        task.isReminderAutoGenerated &&
        task.status === TaskStatus.PENDING &&
        task.reminderOccurrenceTime !== undefined;
    })
    .sort((first: Task, second: Task) => {
      return (first.reminderOccurrenceTime || 0) - (second.reminderOccurrenceTime || 0);
    });
}

function hasCompletedAutoOccurrence(tasks: Task[], eventId: string, occurrenceTime: number): boolean {
  return tasks.some((task: Task) => {
    return task.reminderId === eventId &&
      task.isReminderAutoGenerated &&
      task.status === TaskStatus.COMPLETED &&
      task.reminderOccurrenceTime === occurrenceTime;
  });
}

function hasCompletedReminderOnDate(tasks: Task[], eventId: string, timestamp: number): boolean {
  const day = startOfDay(timestamp);
  return getCompletedReminderTasks(tasks, eventId).some((task: Task) => {
    return startOfDay(task.completedAt || 0) === day;
  });
}

function getDaysInMonth(year: number, month: number): number {
  return new Date(year, month + 1, 0).getDate();
}

function getMonthlyCandidate(year: number, month: number, dayOfMonth: number): number | undefined {
  const daysInMonth = getDaysInMonth(year, month);
  if (dayOfMonth > daysInMonth) {
    return undefined;
  }
  return new Date(year, month, dayOfMonth).getTime();
}

function getMonthlyLastDayCandidate(year: number, month: number, lastDayOffset: number): number {
  const daysInMonth = getDaysInMonth(year, month);
  const day = Math.max(1, daysInMonth - Math.max(lastDayOffset, 1) + 1);
  return new Date(year, month, day).getTime();
}

function getNextWeeklyOccurrence(rule: ReminderRule, referenceTime: number, startTime: number): number {
  const base = Math.max(startOfDay(referenceTime), startOfDay(startTime));
  const baseWeekday = new Date(base).getDay();
  const targetWeekday = rule.weekday !== undefined ? rule.weekday : 1;
  const diff = (targetWeekday - baseWeekday + 7) % 7;
  return applyRuleTime(addDays(base, diff), rule);
}

function getNextMonthlyOccurrence(rule: ReminderRule, referenceTime: number, startTime: number): number | undefined {
  const base = new Date(Math.max(startOfDay(referenceTime), startOfDay(startTime)));
  const targetDay = Math.max(1, rule.dayOfMonth || 1);

  for (let monthOffset = 0; monthOffset < 24; monthOffset++) {
    const year = base.getFullYear();
    const month = base.getMonth() + monthOffset;
    const candidate = getMonthlyCandidate(year + Math.floor(month / 12), month % 12, targetDay);
    if (candidate === undefined) {
      continue;
    }
    const candidateWithTime = applyRuleTime(candidate, rule);
    if (candidateWithTime >= Math.max(referenceTime, startTime)) {
      return candidateWithTime;
    }
  }

  return undefined;
}

function getNextMonthlyLastDayOccurrence(rule: ReminderRule, referenceTime: number, startTime: number): number | undefined {
  const base = new Date(Math.max(startOfDay(referenceTime), startOfDay(startTime)));
  const offset = Math.max(1, rule.lastDayOffset || 1);

  for (let monthOffset = 0; monthOffset < 24; monthOffset++) {
    const rawMonth = base.getMonth() + monthOffset;
    const year = base.getFullYear() + Math.floor(rawMonth / 12);
    const month = rawMonth % 12;
    const candidate = getMonthlyLastDayCandidate(year, month, offset);
    const candidateWithTime = applyRuleTime(candidate, rule);
    if (candidateWithTime >= Math.max(referenceTime, startTime)) {
      return candidateWithTime;
    }
  }

  return undefined;
}

function getNextIntervalOccurrence(rule: ReminderRule, referenceTime: number, startTime: number): number {
  const intervalDays = Math.max(1, rule.intervalDays || 1);
  const start = startOfDay(startTime);
  const referenceDay = Math.max(startOfDay(referenceTime), start);
  const diffDays = Math.floor((referenceDay - start) / (24 * 60 * 60 * 1000));
  const multiplier = Math.ceil(diffDays / intervalDays);
  return applyRuleTime(addDays(start, Math.max(0, multiplier) * intervalDays), rule);
}

function getNextCounterIntervalOccurrence(event: DayEvent, rule: ReminderRule, referenceTime: number): number | undefined {
  const targetDate = getCounterTargetDate(event, rule);
  const timestamp = applyRuleTime(targetDate, rule);
  return timestamp >= referenceTime ? timestamp : undefined;
}

function getNextCounterDateOccurrence(rule: ReminderRule, referenceTime: number): number | undefined {
  if (!rule.targetDate) {
    return undefined;
  }
  const timestamp = applyRuleTime(rule.targetDate, rule);
  return timestamp >= referenceTime ? timestamp : undefined;
}

function getNextLeadOccurrence(event: DayEvent, rule: ReminderRule, referenceTime: number): number | undefined {
  const targetDate = event.targetDate || event.startDate;
  const leadDate = addDays(targetDate, -(rule.leadDays || 0));
  const timestamp = applyRuleTime(leadDate, rule);
  return timestamp >= referenceTime ? timestamp : undefined;
}

function getNextDailyOccurrence(rule: ReminderRule, referenceTime: number, startTime: number): number {
  const baseDay = Math.max(startOfDay(referenceTime), startOfDay(startTime));
  const candidate = applyRuleTime(baseDay, rule);
  if (candidate >= referenceTime) {
    return candidate;
  }
  return applyRuleTime(addDays(baseDay, 1), rule);
}

function getNextRuleOccurrence(event: DayEvent, rule: ReminderRule, referenceTime: number): number | undefined {
  const effectiveStartTime = applyRuleTime(event.startDate, rule);

  switch (rule.type) {
    case ReminderType.PERIODIC_DAILY:
    case ReminderType.HABIT_DAILY:
      return getNextDailyOccurrence(rule, referenceTime, effectiveStartTime);
    case ReminderType.PERIODIC_WEEKLY:
      return getNextWeeklyOccurrence(rule, referenceTime, effectiveStartTime);
    case ReminderType.PERIODIC_MONTHLY:
      return getNextMonthlyOccurrence(rule, referenceTime, effectiveStartTime);
    case ReminderType.PERIODIC_MONTHLY_LAST_DAY:
      return getNextMonthlyLastDayOccurrence(rule, referenceTime, effectiveStartTime);
    case ReminderType.PERIODIC_INTERVAL:
      return getNextIntervalOccurrence(rule, referenceTime, effectiveStartTime);
    case ReminderType.MILESTONE_LEAD:
      return getNextLeadOccurrence(event, rule, referenceTime);
    case ReminderType.COUNTER_INTERVAL:
      return getNextCounterIntervalOccurrence(event, rule, referenceTime);
    case ReminderType.COUNTER_DATE:
      return getNextCounterDateOccurrence(rule, referenceTime);
    default:
      return undefined;
  }
}

export function getReminderCompletionCount(tasks: Task[], eventId: string): number {
  return getCompletedReminderTasks(tasks, eventId).length;
}

export function getReminderPeriodProgress(event: DayEvent, tasks: Task[], referenceTime: number = Date.now()): ReminderPeriodProgress | null {
  const countRule = event.reminderRules.find((rule: ReminderRule) => {
    return rule.type === ReminderType.HABIT_WEEKLY_TARGET || rule.type === ReminderType.HABIT_MONTHLY_TARGET;
  });

  if (!countRule) {
    return null;
  }

  const range = getCurrentPeriodRange(countRule, referenceTime);
  if (!range) {
    return null;
  }

  return {
    label: range.label,
    completed: getCompletedCountInRange(tasks, event.id, range.start, range.end),
    target: Math.max(1, countRule.timesPerPeriod || 1)
  };
}

function getCountTargetPlan(event: DayEvent, rule: ReminderRule, tasks: Task[], referenceTime: number): ReminderTaskPlan | null {
  const range = getCurrentPeriodRange(rule, referenceTime);
  if (!range) {
    return null;
  }

  const target = Math.max(1, rule.timesPerPeriod || 1);
  const completed = getCompletedCountInRange(tasks, event.id, range.start, range.end);
  if (completed >= target) {
    return null;
  }

  const dueTime = applyRuleTime(Math.max(startOfDay(referenceTime), startOfDay(event.startDate)), rule);
  return {
    occurrenceTime: dueTime,
    dueDate: dueTime,
    summary: `${range.label}目标 ${completed + 1}/${target}`
  };
}

export function planNextReminderTask(event: DayEvent, tasks: Task[], referenceTime: number = Date.now()): ReminderTaskPlan | null {
  if (!event.isEnabled || event.isCompleted) {
    return null;
  }

  const countRule = event.reminderRules.find((rule: ReminderRule) => {
    return rule.type === ReminderType.HABIT_WEEKLY_TARGET || rule.type === ReminderType.HABIT_MONTHLY_TARGET;
  });

  if (countRule) {
    return getCountTargetPlan(event, countRule, tasks, referenceTime);
  }

  const lastCompletedOccurrence = getLastCompletedAutoOccurrence(tasks, event.id);
  const nextSearchTime = lastCompletedOccurrence !== undefined
    ? lastCompletedOccurrence + 60 * 1000
    : referenceTime;

  let nextRule: ReminderRule | undefined;
  let nextOccurrence: number | undefined;

  for (const rule of event.reminderRules) {
    const occurrence = getNextRuleOccurrence(event, rule, nextSearchTime);
    if (occurrence === undefined) {
      continue;
    }

    if (nextOccurrence === undefined || occurrence < nextOccurrence) {
      nextOccurrence = occurrence;
      nextRule = rule;
    }
  }

  if (nextOccurrence === undefined) {
    if (event.type === DayEventType.COUNTDOWN && event.targetDate) {
      const occurrenceTime = startOfDay(event.targetDate);
      if (!hasCompletedAutoOccurrence(tasks, event.id, occurrenceTime) &&
        occurrenceTime >= startOfDay(referenceTime)) {
        return {
          occurrenceTime,
          dueDate: occurrenceTime,
          summary: `目标：${formatDayEventDate(event.targetDate)}`
        };
      }
    }

    if (event.type === DayEventType.MILESTONE && event.targetDate) {
      const occurrenceTime = startOfDay(event.targetDate);
      if (!hasCompletedAutoOccurrence(tasks, event.id, occurrenceTime) &&
        occurrenceTime >= startOfDay(referenceTime)) {
        return {
          occurrenceTime,
          dueDate: occurrenceTime,
          summary: `重要日子 ${formatDayEventDate(event.targetDate)}`
        };
      }
    }
    return null;
  }

  return {
    occurrenceTime: nextOccurrence,
    dueDate: nextOccurrence,
    summary: nextRule ? getReminderSummary(nextRule) : formatDayEventDate(nextOccurrence)
  };
}

export function createReminderAutoTask(event: DayEvent, plan: ReminderTaskPlan): Task {
  const task = new Task(event.title, event.goalId || '', event.goalTitle || '');
  task.description = `来自提醒：${plan.summary}`;
  task.reminderId = event.id;
  task.reminderTitle = event.title;
  task.krId = event.krId;
  task.krTitle = event.krTitle;
  task.isReminderAutoGenerated = true;
  task.reminderOccurrenceTime = plan.occurrenceTime;
  task.dueDate = plan.dueDate;
  return task;
}

export function shouldKeepPendingReminderTask(event: DayEvent, tasks: Task[], pendingTask: Task, referenceTime: number = Date.now()): boolean {
  const plan = planNextReminderTask(event, tasks, referenceTime);
  if (!plan) {
    return false;
  }

  return pendingTask.reminderOccurrenceTime === plan.occurrenceTime;
}

export function buildReminderTaskSubtitle(task: Task): string {
  if (!task.reminderTitle) {
    return '';
  }

  if (task.isReminderAutoGenerated && task.reminderOccurrenceTime) {
    const date = formatDayEventDate(task.reminderOccurrenceTime);
    const time = new Date(task.reminderOccurrenceTime);
      return `${task.reminderTitle} · ${date} ${formatDayEventTime(time.getHours(), time.getMinutes())}`;
  }

    return task.reminderTitle;
}

export function getNextReminderOccurrenceTime(event: DayEvent, tasks: Task[], referenceTime: number = Date.now()): number | undefined {
  const plan = planNextReminderTask(event, tasks, referenceTime);
  return plan?.occurrenceTime;
}

function getDirectCompletionCandidate(event: DayEvent, tasks: Task[], referenceTime: number): ReminderCompletionCandidate | null {
  const occurrenceTime = getDayEventOccurrenceTimeOnDate(event, referenceTime);
  if (occurrenceTime === undefined || occurrenceTime > endOfDay(referenceTime)) {
    return null;
  }
  if (hasCompletedReminderOnDate(tasks, event.id, referenceTime)) {
    return null;
  }
  return { occurrenceTime };
}

export function getReminderCompletionCandidate(event: DayEvent, tasks: Task[], referenceTime: number = Date.now()): ReminderCompletionCandidate | null {
  const pendingTasks = getPendingReminderTasks(tasks, event.id);
  if (pendingTasks.length > 0) {
    const endToday = endOfDay(referenceTime);
    const currentTask = pendingTasks.find((task: Task) => (task.reminderOccurrenceTime || 0) <= endToday);
    if (!currentTask) {
      return getDirectCompletionCandidate(event, tasks, referenceTime);
    }
    const targetTask = currentTask;
    return {
      occurrenceTime: targetTask.reminderOccurrenceTime || referenceTime,
      task: targetTask
    };
  }

  const plan = planNextReminderTask(event, tasks, referenceTime);
  if (plan && plan.occurrenceTime <= endOfDay(referenceTime)) {
    return {
      occurrenceTime: plan.occurrenceTime
    };
  }

  return getDirectCompletionCandidate(event, tasks, referenceTime);
}

export function autoCompleteExpirations(events: DayEvent[], tasks: Task[]): boolean {
  let updated = false;
  const now = Date.now();
  events.forEach(event => {
    if (event.isEnabled && !event.isCompleted && event.endDate !== undefined) {
      if (now > event.endDate) {
        const autoTasks = tasks.filter(t => t.reminderId === event.id && t.isReminderAutoGenerated);
        if (autoTasks.length > 0 && autoTasks.every(t => t.status === TaskStatus.COMPLETED)) {
          event.isCompleted = true;
          updated = true;
        }
      }
    }
  });
  return updated;
}
