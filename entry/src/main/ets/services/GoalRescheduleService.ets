import { DayEvent, DayEventType, ReminderType } from '../models/DayEvent';
import { Goal } from '../models/Goal';
import { Task, TaskStatus } from '../models/Task';
import { db } from '../storage/Database';

const DAY_MS: number = 24 * 60 * 60 * 1000;

export interface GoalRescheduleContext {
  goal: Goal | null;
  totalTaskCount: number;
  completedTaskCount: number;
  remainingTaskCount: number;
  schedulableTaskCount: number;
  unscheduledTaskCount: number;
  autoGeneratedTaskCount: number;
  earliestPendingDate?: number;
  lastCompletedAt?: number;
  supportedReminderCount: number;
  unsupportedReminderCount: number;
}

export interface GoalRescheduleTaskMove {
  id: string;
  title: string;
  oldDate: number;
  newDate: number;
  dueTime?: string;
}

export interface GoalRescheduleTaskPreviewItem {
  id: string;
  title: string;
  status: 'move' | 'keep' | 'cleanup';
  note: string;
  oldDate?: number;
  newDate?: number;
  dueTime?: string;
  adjustable: boolean;
  manualAdjusted: boolean;
  systemSuggestedDate?: number;
}

export interface GoalRescheduleReminderMove {
  id: string;
  title: string;
  type: DayEventType;
  oldDate: number;
  newDate: number;
}

export interface GoalRescheduleReminderPreviewItem {
  id: string;
  title: string;
  type: DayEventType;
  status: 'move' | 'keep';
  note: string;
  oldDate?: number;
  newDate?: number;
  adjustable: boolean;
  manualAdjusted: boolean;
  systemSuggestedDate?: number;
}

export interface GoalReschedulePreview {
  goalId: string;
  newStartDate: number;
  offsetDays: number;
  syncReminders: boolean;
  taskMoves: GoalRescheduleTaskMove[];
  reminderMoves: GoalRescheduleReminderMove[];
  taskPreviewItems: GoalRescheduleTaskPreviewItem[];
  reminderPreviewItems: GoalRescheduleReminderPreviewItem[];
  affectedTaskCount: number;
  affectedReminderCount: number;
  movedTaskCount: number;
  unchangedTaskCount: number;
  manualAdjustedTaskCount: number;
  manualAdjustedReminderCount: number;
  totalReminderCount: number;
  unsupportedReminderCount: number;
  cleanedAutoGeneratedTaskCount: number;
}

export interface GoalRescheduleApplyResult {
  taskCount: number;
  reminderCount: number;
  cleanedAutoGeneratedTaskCount: number;
}

export class GoalRescheduleService {
  public static async loadContext(context: Context, goalId: string): Promise<GoalRescheduleContext> {
    if (!db.isInitialized()) {
      await db.initialize(context);
    }

    const goal = db.getGoalById(goalId) || null;
    if (!goal) {
      return {
        goal: null,
        totalTaskCount: 0,
        completedTaskCount: 0,
        remainingTaskCount: 0,
        schedulableTaskCount: 0,
        unscheduledTaskCount: 0,
        autoGeneratedTaskCount: 0,
        supportedReminderCount: 0,
        unsupportedReminderCount: 0
      };
    }

    const tasks = db.getTasksByGoalId(goalId);
    const reminders = db.getDayEventsByGoalId(goalId);
    const completedTasks = tasks.filter((task: Task) => GoalRescheduleService.isCompletedTask(task));
    const remainingTasks = tasks.filter((task: Task) => GoalRescheduleService.isIncompleteTask(task));
    const schedulableTasks = remainingTasks.filter((task: Task) => GoalRescheduleService.isSchedulableTask(task));
    const unscheduledTasks = remainingTasks.filter((task: Task) => !task.dueDate && !GoalRescheduleService.isReminderGeneratedTask(task));
    const autoGeneratedTasks = remainingTasks.filter((task: Task) => GoalRescheduleService.isReminderGeneratedTask(task));
    const earliestPendingDate = GoalRescheduleService.getEarliestPendingDate(schedulableTasks);
    const lastCompletedAt = GoalRescheduleService.getLastCompletedAt(completedTasks);
    const supportedReminderCount = reminders.filter((event: DayEvent) => GoalRescheduleService.canShiftReminder(event)).length;

    return {
      goal,
      totalTaskCount: tasks.length,
      completedTaskCount: completedTasks.length,
      remainingTaskCount: remainingTasks.length,
      schedulableTaskCount: schedulableTasks.length,
      unscheduledTaskCount: unscheduledTasks.length,
      autoGeneratedTaskCount: autoGeneratedTasks.length,
      earliestPendingDate,
      lastCompletedAt,
      supportedReminderCount,
      unsupportedReminderCount: Math.max(0, reminders.length - supportedReminderCount)
    };
  }

  public static async buildPreview(
    context: Context,
    goalId: string,
    nextStartDate: number,
    syncReminders: boolean
  ): Promise<GoalReschedulePreview | null> {
    if (!db.isInitialized()) {
      await db.initialize(context);
    }

    const goal = db.getGoalById(goalId);
    if (!goal) {
      return null;
    }

    const goalTasks = db.getTasksByGoalId(goalId)
      .filter((task: Task) => GoalRescheduleService.isIncompleteTask(task))
      .sort((first: Task, second: Task) => GoalRescheduleService.comparePreviewTasks(first, second));
    const schedulableTasks = goalTasks
      .filter((task: Task) => GoalRescheduleService.isSchedulableTask(task))
      .sort((first: Task, second: Task) => GoalRescheduleService.compareTasks(first, second));
    if (schedulableTasks.length === 0) {
      return null;
    }

    const earliestPendingDate = GoalRescheduleService.getEarliestPendingDate(schedulableTasks);
    if (earliestPendingDate === undefined) {
      return null;
    }

    const normalizedStart = GoalRescheduleService.normalizeDate(nextStartDate);
    const offsetDays = Math.trunc((normalizedStart - earliestPendingDate) / DAY_MS);

    const taskMoves: GoalRescheduleTaskMove[] = schedulableTasks.map((task: Task) => {
      const move: GoalRescheduleTaskMove = {
        id: task.id,
        title: task.title,
        oldDate: task.dueDate!,
        newDate: GoalRescheduleService.shiftDate(task.dueDate!, offsetDays),
        dueTime: task.dueTime
      };
      return move;
    });

    const taskPreviewItems: GoalRescheduleTaskPreviewItem[] = goalTasks.map((task: Task) => {
      if (GoalRescheduleService.isSchedulableTask(task)) {
        const newDate = GoalRescheduleService.shiftDate(task.dueDate!, offsetDays);
        const isChanged = newDate !== task.dueDate!;
        const item: GoalRescheduleTaskPreviewItem = {
          id: task.id,
          title: task.title,
          status: isChanged ? 'move' : 'keep',
          note: isChanged ? GoalRescheduleService.getShiftDirectionText(offsetDays) : '无需调整日期',
          oldDate: task.dueDate,
          newDate,
          dueTime: task.dueTime,
          adjustable: true,
          manualAdjusted: false,
          systemSuggestedDate: newDate
        };
        return item;
      }

      if (GoalRescheduleService.isReminderGeneratedTask(task)) {
        const item: GoalRescheduleTaskPreviewItem = {
          id: task.id,
          title: task.title,
          status: 'cleanup',
          note: '来自周期提醒的旧待办，将在应用时清理',
          oldDate: task.dueDate || task.reminderOccurrenceTime,
          dueTime: task.dueTime,
          adjustable: false,
          manualAdjusted: false
        };
        return item;
      }

      const item: GoalRescheduleTaskPreviewItem = {
        id: task.id,
        title: task.title,
        status: 'keep',
        note: task.dueDate === undefined ? '暂无日期，无需调整日期' : '无需调整日期',
        oldDate: task.dueDate,
        dueTime: task.dueTime,
        adjustable: false,
        manualAdjusted: false
      };
      return item;
    });

    const reminders = db.getDayEventsByGoalId(goalId);
    const reminderPreviewItems: GoalRescheduleReminderPreviewItem[] = reminders.map((event: DayEvent) => {
      return GoalRescheduleService.buildReminderPreviewItem(event, offsetDays, syncReminders);
    });
    return GoalRescheduleService.rebuildPreviewSummary({
      goalId,
      newStartDate: normalizedStart,
      offsetDays,
      syncReminders,
      taskMoves: [],
      reminderMoves: [],
      taskPreviewItems,
      reminderPreviewItems,
      affectedTaskCount: 0,
      affectedReminderCount: 0,
      movedTaskCount: 0,
      unchangedTaskCount: 0,
      manualAdjustedTaskCount: 0,
      manualAdjustedReminderCount: 0,
      totalReminderCount: 0,
      unsupportedReminderCount: 0,
      cleanedAutoGeneratedTaskCount: db.getTasksByGoalId(goalId)
        .filter((task: Task) => GoalRescheduleService.isIncompleteTask(task) && GoalRescheduleService.isReminderGeneratedTask(task)).length,
    });
  }

  public static async applyPreview(
    context: Context,
    preview: GoalReschedulePreview
  ): Promise<GoalRescheduleApplyResult> {
    if (!db.isInitialized()) {
      await db.initialize(context);
    }

    let taskCount = 0;
    let reminderCount = 0;
    const cleanedAutoGeneratedTaskCount = await GoalRescheduleService.cleanupPendingAutoGeneratedTasks(preview.goalId);

    for (const move of preview.taskMoves) {
      const task = db.getTaskById(move.id);
      if (!task || task.goalId !== preview.goalId || !GoalRescheduleService.isSchedulableTask(task)) {
        continue;
      }

      if (task.dueDate === move.newDate) {
        continue;
      }

      task.dueDate = move.newDate;
      await db.updateTask(task);
      taskCount += 1;
    }

    if (preview.syncReminders) {
      for (const move of preview.reminderMoves) {
        const event = db.getDayEventById(move.id);
        if (!event || event.goalId !== preview.goalId || !GoalRescheduleService.canShiftReminder(event)) {
          continue;
        }

        if (!GoalRescheduleService.applyReminderPreviewMove(event, move.oldDate, move.newDate)) {
          continue;
        }

        await db.updateDayEvent(event);
        reminderCount += 1;
      }
    }

    const goal = db.getGoalById(preview.goalId);
    if (goal) {
      goal.updatedAt = Date.now();
      await db.updateGoal(goal);
    }

    return { taskCount, reminderCount, cleanedAutoGeneratedTaskCount };
  }

  public static getSuggestedStartDate(context: GoalRescheduleContext): number {
    const today = GoalRescheduleService.normalizeDate(Date.now());
    const tomorrow = today + DAY_MS;
    if (context.earliestPendingDate === undefined) {
      return tomorrow;
    }
    return context.earliestPendingDate < today ? tomorrow : context.earliestPendingDate;
  }

  private static copyTaskPreviewItem(item: GoalRescheduleTaskPreviewItem): GoalRescheduleTaskPreviewItem {
    return {
      id: item.id,
      title: item.title,
      status: item.status,
      note: item.note,
      oldDate: item.oldDate,
      newDate: item.newDate,
      dueTime: item.dueTime,
      adjustable: item.adjustable,
      manualAdjusted: item.manualAdjusted,
      systemSuggestedDate: item.systemSuggestedDate
    };
  }

  private static copyReminderPreviewItem(item: GoalRescheduleReminderPreviewItem): GoalRescheduleReminderPreviewItem {
    return {
      id: item.id,
      title: item.title,
      type: item.type,
      status: item.status,
      note: item.note,
      oldDate: item.oldDate,
      newDate: item.newDate,
      adjustable: item.adjustable,
      manualAdjusted: item.manualAdjusted,
      systemSuggestedDate: item.systemSuggestedDate
    };
  }

  public static updateTaskPreviewDate(
    preview: GoalReschedulePreview,
    taskId: string,
    nextDate: number
  ): GoalReschedulePreview {
    const taskPreviewItems = preview.taskPreviewItems.map((item: GoalRescheduleTaskPreviewItem) => {
      if (item.id !== taskId || !item.adjustable || item.oldDate === undefined) {
        return GoalRescheduleService.copyTaskPreviewItem(item);
      }
      const normalizedNext = GoalRescheduleService.normalizeDate(nextDate);
      const nextStatus: 'move' | 'keep' = normalizedNext === item.oldDate ? 'keep' : 'move';
      const manualAdjusted = item.systemSuggestedDate !== undefined && normalizedNext !== item.systemSuggestedDate;
      return {
        id: item.id,
        title: item.title,
        status: nextStatus,
        note: GoalRescheduleService.getTaskPreviewNote(item.oldDate, normalizedNext, manualAdjusted),
        oldDate: item.oldDate,
        newDate: normalizedNext,
        dueTime: item.dueTime,
        adjustable: item.adjustable,
        manualAdjusted: manualAdjusted,
        systemSuggestedDate: item.systemSuggestedDate
      };
    });

    const newPreview: GoalReschedulePreview = {
      goalId: preview.goalId,
      newStartDate: preview.newStartDate,
      offsetDays: preview.offsetDays,
      syncReminders: preview.syncReminders,
      taskMoves: preview.taskMoves,
      reminderMoves: preview.reminderMoves,
      taskPreviewItems: taskPreviewItems,
      reminderPreviewItems: preview.reminderPreviewItems.map((item: GoalRescheduleReminderPreviewItem) => GoalRescheduleService.copyReminderPreviewItem(item)),
      affectedTaskCount: preview.affectedTaskCount,
      affectedReminderCount: preview.affectedReminderCount,
      movedTaskCount: preview.movedTaskCount,
      unchangedTaskCount: preview.unchangedTaskCount,
      manualAdjustedTaskCount: preview.manualAdjustedTaskCount,
      manualAdjustedReminderCount: preview.manualAdjustedReminderCount,
      totalReminderCount: preview.totalReminderCount,
      unsupportedReminderCount: preview.unsupportedReminderCount,
      cleanedAutoGeneratedTaskCount: preview.cleanedAutoGeneratedTaskCount
    };
    return GoalRescheduleService.rebuildPreviewSummary(newPreview);
  }

