      const nextStatus: 'move' | 'keep' = item.systemSuggestedDate === item.oldDate ? 'keep' : 'move';
      return {
        id: item.id,
        title: item.title,
        status: nextStatus,
        note: GoalRescheduleService.getTaskPreviewNote(item.oldDate, item.systemSuggestedDate, false),
        oldDate: item.oldDate,
        newDate: item.systemSuggestedDate,
        dueTime: item.dueTime,
        adjustable: item.adjustable,
        manualAdjusted: false,
        systemSuggestedDate: item.systemSuggestedDate
