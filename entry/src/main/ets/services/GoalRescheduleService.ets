  private static isSchedulableTask(task: Task): boolean {
    return GoalRescheduleService.isIncompleteTask(task) &&
      task.dueDate !== undefined &&
      !GoalRescheduleService.isReminderGeneratedTask(task);
  }

  private static isIncompleteTask(task: Task): boolean {
    return task.status !== TaskStatus.COMPLETED;
  }

  private static isCompletedTask(task: Task): boolean {
    return task.status === TaskStatus.COMPLETED;
  }

  private static isReminderGeneratedTask(task: Task): boolean {
    if (!task.reminderId) {
      return false;
    }
    if (task.isReminderAutoGenerated || task.reminderOccurrenceTime !== undefined) {
      return true;
    }
    return (task.description || '').startsWith('来自提醒：');
  }

  private static getEarliestPendingDate(tasks: Task[]): number | undefined {
    if (tasks.length === 0) {
      return undefined;
    }
    const sorted = tasks.slice().sort((first: Task, second: Task) => GoalRescheduleService.compareTasks(first, second));
    return GoalRescheduleService.normalizeDate(sorted[0].dueDate!);
  }

  private static getLastCompletedAt(tasks: Task[]): number | undefined {
    if (tasks.length === 0) {
      return undefined;
    }
    return tasks.reduce((latest: number, task: Task) => {
      const completedAt = task.completedAt || 0;
      return completedAt > latest ? completedAt : latest;
    }, 0) || undefined;
  }

  private static compareTasks(first: Task, second: Task): number {
    const firstDate = first.dueDate || 0;
    const secondDate = second.dueDate || 0;
    if (firstDate !== secondDate) {
      return firstDate - secondDate;
    }
    const firstTime = first.dueTime || '23:59';
    const secondTime = second.dueTime || '23:59';
    if (firstTime !== secondTime) {
      return firstTime.localeCompare(secondTime);
    }
    return first.createdAt - second.createdAt;
  }

  private static comparePreviewTasks(first: Task, second: Task): number {
    const firstAnchor = first.dueDate || first.reminderOccurrenceTime || Number.MAX_SAFE_INTEGER;
    const secondAnchor = second.dueDate || second.reminderOccurrenceTime || Number.MAX_SAFE_INTEGER;
    if (firstAnchor !== secondAnchor) {
      return firstAnchor - secondAnchor;
    }
    return first.createdAt - second.createdAt;
  }

  private static normalizeDate(timestamp: number): number {
    const date = new Date(timestamp);
    date.setHours(0, 0, 0, 0);
    return date.getTime();
  }

  private static shiftDate(timestamp: number, offsetDays: number): number {
    const shifted = new Date(timestamp);
    shifted.setDate(shifted.getDate() + offsetDays);
    return shifted.getTime();
  }

  private static canShiftReminder(event: DayEvent): boolean {
    return GoalRescheduleService.getReminderAnchorDate(event) !== undefined;
  }

  private static getReminderAnchorDate(event: DayEvent): number | undefined {
    if (event.type === DayEventType.PERIODIC || event.type === DayEventType.HABIT) {
      return event.startDate;
    }

    if (event.type === DayEventType.MILESTONE || event.type === DayEventType.COUNTDOWN) {
      return event.targetDate;
    }

    if (event.type === DayEventType.COUNTER) {
      const hasCounterDateRule = (event.reminderRules || []).some((rule) => rule.type === ReminderType.COUNTER_DATE);
      if (hasCounterDateRule) {
        return event.targetDate;
      }
      if (event.counterStartDate !== undefined) {
        return event.counterStartDate;
      }
    }

    return undefined;
  }

  private static buildReminderPreviewItem(
    event: DayEvent,
    offsetDays: number,
    syncReminders: boolean
  ): GoalRescheduleReminderPreviewItem {
    if (!syncReminders) {
      const item: GoalRescheduleReminderPreviewItem = {
        id: event.id,
        title: event.title,
        type: event.type,
        status: 'keep',
        note: '本次不会同步调整提醒',
        adjustable: false,
        manualAdjusted: false
      };
      return item;
    }

    const oldDate = GoalRescheduleService.getReminderAnchorDate(event);
    if (oldDate === undefined) {
      const item: GoalRescheduleReminderPreviewItem = {
        id: event.id,
        title: event.title,
        type: event.type,
        status: 'keep',
        note: '当前规则暂不支持自动调整',
        adjustable: false,
        manualAdjusted: false
      };
      return item;
    }

    const newDate = GoalRescheduleService.shiftDate(oldDate, offsetDays);
    const isChanged = oldDate !== newDate;
    const item: GoalRescheduleReminderPreviewItem = {
      id: event.id,
      title: event.title,
      type: event.type,
      status: isChanged ? 'move' : 'keep',
      note: isChanged ? GoalRescheduleService.getReminderShiftNote(event, offsetDays) : '无需调整日期',
      oldDate,
      newDate,
      adjustable: true,
      manualAdjusted: false,
      systemSuggestedDate: newDate
    };
    return item;
  }

  private static getReminderShiftNote(event: DayEvent, offsetDays: number): string {
    if (event.type === DayEventType.PERIODIC || event.type === DayEventType.HABIT) {
      return event.endDate !== undefined
        ? `开始和结束日期会同步${GoalRescheduleService.getShiftDirectionText(offsetDays)}`
        : `开始日期会同步${GoalRescheduleService.getShiftDirectionText(offsetDays)}`;
    }
    if (event.type === DayEventType.COUNTER && event.counterStartDate !== undefined && event.targetDate === undefined) {
      return `起算日期会同步${GoalRescheduleService.getShiftDirectionText(offsetDays)}`;
    }
    return `提醒日期会同步${GoalRescheduleService.getShiftDirectionText(offsetDays)}`;
  }

  private static getShiftDirectionText(offsetDays: number): string {
    if (offsetDays > 0) {
      return `后移 ${offsetDays} 天`;
    }
    if (offsetDays < 0) {
      return `前移 ${Math.abs(offsetDays)} 天`;
    }
    return '保持不变';
  }

  private static getTaskPreviewNote(oldDate: number, newDate: number, manualAdjusted: boolean): string {
    if (oldDate === newDate) {
      return manualAdjusted ? '已手动调整为原日期，无需改动' : '无需调整日期';
    }
    const offsetDays = Math.trunc((GoalRescheduleService.normalizeDate(newDate) - GoalRescheduleService.normalizeDate(oldDate)) / DAY_MS);
    return manualAdjusted ? `已手动调整，${GoalRescheduleService.getShiftDirectionText(offsetDays)}` : GoalRescheduleService.getShiftDirectionText(offsetDays);
  }

  private static getReminderPreviewNote(type: DayEventType, oldDate: number, newDate: number, manualAdjusted: boolean): string {
    if (oldDate === newDate) {
      return manualAdjusted ? '已手动调整为原日期，无需改动' : '无需调整日期';
    }
    const offsetDays = Math.trunc((GoalRescheduleService.normalizeDate(newDate) - GoalRescheduleService.normalizeDate(oldDate)) / DAY_MS);
    if (!manualAdjusted) {
      return GoalRescheduleService.getReminderShiftNoteByType(type, offsetDays);
    }
    return `已手动调整，${GoalRescheduleService.getReminderShiftNoteByType(type, offsetDays)}`;
  }

  private static getReminderShiftNoteByType(type: DayEventType, offsetDays: number): string {
    if (type === DayEventType.PERIODIC || type === DayEventType.HABIT) {
      return `开始日期会同步${GoalRescheduleService.getShiftDirectionText(offsetDays)}`;
    }
    if (type === DayEventType.COUNTER) {
      return `起算或提醒日期会同步${GoalRescheduleService.getShiftDirectionText(offsetDays)}`;
    }
    return `提醒日期会同步${GoalRescheduleService.getShiftDirectionText(offsetDays)}`;
  }

  private static rebuildPreviewSummary(preview: GoalReschedulePreview): GoalReschedulePreview {
    const taskPreviewItems = preview.taskPreviewItems.map((item: GoalRescheduleTaskPreviewItem) => GoalRescheduleService.copyTaskPreviewItem(item));
    const reminderPreviewItems = preview.reminderPreviewItems.map((item: GoalRescheduleReminderPreviewItem) => GoalRescheduleService.copyReminderPreviewItem(item));

    const taskMoves: GoalRescheduleTaskMove[] = taskPreviewItems
      .filter((item: GoalRescheduleTaskPreviewItem) => item.adjustable && item.oldDate !== undefined && item.newDate !== undefined)
      .map((item: GoalRescheduleTaskPreviewItem) => {
        const move: GoalRescheduleTaskMove = {
          id: item.id,
          title: item.title,
          oldDate: item.oldDate!,
          newDate: item.newDate!,
          dueTime: item.dueTime
        };
        return move;
      });

    const reminderMoves: GoalRescheduleReminderMove[] = reminderPreviewItems
      .filter((item: GoalRescheduleReminderPreviewItem) => item.adjustable && item.oldDate !== undefined && item.newDate !== undefined)
      .map((item: GoalRescheduleReminderPreviewItem) => {
        const move: GoalRescheduleReminderMove = {
          id: item.id,
          title: item.title,
          type: item.type,
          oldDate: item.oldDate!,
          newDate: item.newDate!
        };
        return move;
      });

    const firstTaskMove = taskMoves.slice().sort((first: GoalRescheduleTaskMove, second: GoalRescheduleTaskMove) => first.oldDate - second.oldDate)[0];
    const earliestNextTaskMove = taskMoves.slice().sort((first: GoalRescheduleTaskMove, second: GoalRescheduleTaskMove) => first.newDate - second.newDate)[0];
    const nextStartDate = earliestNextTaskMove ? earliestNextTaskMove.newDate : preview.newStartDate;
    const offsetDays = firstTaskMove
      ? Math.trunc((GoalRescheduleService.normalizeDate(firstTaskMove.newDate) - GoalRescheduleService.normalizeDate(firstTaskMove.oldDate)) / DAY_MS)
      : preview.offsetDays;

    const result: GoalReschedulePreview = {
      goalId: preview.goalId,
      newStartDate: nextStartDate,
      offsetDays,
      syncReminders: preview.syncReminders,
      taskMoves,
      reminderMoves,
      taskPreviewItems,
      reminderPreviewItems,
      affectedTaskCount: taskPreviewItems.length,
      affectedReminderCount: reminderPreviewItems.filter((item: GoalRescheduleReminderPreviewItem) => item.status === 'move').length,
      movedTaskCount: taskPreviewItems.filter((item: GoalRescheduleTaskPreviewItem) => item.status === 'move').length,
      unchangedTaskCount: taskPreviewItems.filter((item: GoalRescheduleTaskPreviewItem) => item.status === 'keep').length,
      manualAdjustedTaskCount: taskPreviewItems.filter((item: GoalRescheduleTaskPreviewItem) => item.manualAdjusted).length,
      manualAdjustedReminderCount: reminderPreviewItems.filter((item: GoalRescheduleReminderPreviewItem) => item.manualAdjusted).length,
      totalReminderCount: reminderPreviewItems.length,
      unsupportedReminderCount: reminderPreviewItems.filter((item: GoalRescheduleReminderPreviewItem) => !item.adjustable).length,
      cleanedAutoGeneratedTaskCount: preview.cleanedAutoGeneratedTaskCount
    };
    return result;
  }

  private static applyReminderPreviewMove(event: DayEvent, oldDate: number, newDate: number): boolean {
    const offsetDays = Math.trunc((GoalRescheduleService.normalizeDate(newDate) - GoalRescheduleService.normalizeDate(oldDate)) / DAY_MS);
    return GoalRescheduleService.applyShiftedReminderDate(event, offsetDays);
  }

  private static applyShiftedReminderDate(event: DayEvent, offsetDays: number): boolean {
    let changed = false;

    if (event.type === DayEventType.PERIODIC || event.type === DayEventType.HABIT) {
      const nextStartDate = GoalRescheduleService.shiftDate(event.startDate, offsetDays);
      if (event.startDate !== nextStartDate) {
        event.startDate = nextStartDate;
        changed = true;
      }
      if (event.endDate !== undefined) {
        const nextEndDate = GoalRescheduleService.shiftDate(event.endDate, offsetDays);
        if (event.endDate !== nextEndDate) {
          event.endDate = nextEndDate;
          changed = true;
        }
      }
      if (event.skipOnceUntil !== undefined) {
        const nextSkipOnceUntil = GoalRescheduleService.shiftDate(event.skipOnceUntil, offsetDays);
        if (event.skipOnceUntil !== nextSkipOnceUntil) {
          event.skipOnceUntil = nextSkipOnceUntil;
          changed = true;
        }
      }
      return changed;
    }

    const previousTargetDate = event.targetDate;
    if (event.type === DayEventType.MILESTONE || event.type === DayEventType.COUNTDOWN) {
      const nextTargetDate = GoalRescheduleService.shiftDate(previousTargetDate || event.startDate, offsetDays);
      event.targetDate = nextTargetDate;
      return previousTargetDate !== nextTargetDate;
    }

    if (event.type === DayEventType.COUNTER) {
      const hasCounterDateRule = (event.reminderRules || []).some((rule) => rule.type === ReminderType.COUNTER_DATE);
      if (hasCounterDateRule) {
        const nextTargetDate = GoalRescheduleService.shiftDate(previousTargetDate || event.startDate, offsetDays);
        event.targetDate = nextTargetDate;
        return previousTargetDate !== nextTargetDate;
      }
      if (event.counterStartDate !== undefined) {
        const nextCounterStartDate = GoalRescheduleService.shiftDate(event.counterStartDate, offsetDays);
        if (event.counterStartDate !== nextCounterStartDate) {
          event.counterStartDate = nextCounterStartDate;
          return true;
        }
      }
    }

    return false;
  }

  private static async cleanupPendingAutoGeneratedTasks(goalId: string): Promise<number> {
    const goalTasks = db.getTasksByGoalId(goalId);
    const pendingAutoTasks = goalTasks.filter((task: Task) => {
      return GoalRescheduleService.isIncompleteTask(task) && GoalRescheduleService.isReminderGeneratedTask(task);
    });
    if (pendingAutoTasks.length === 0) {
      return 0;
    }

    const beforeCount = pendingAutoTasks.length;
    for (const task of pendingAutoTasks) {
      const currentTask = db.getTaskById(task.id);
      if (!currentTask) {
        continue;
      }
      await db.deleteTask(task.id);
    }

    const afterCount = db.getTasksByGoalId(goalId).filter((task: Task) => {
      return GoalRescheduleService.isIncompleteTask(task) && GoalRescheduleService.isReminderGeneratedTask(task);
    }).length;
    return Math.max(0, beforeCount - afterCount);
  }
}
