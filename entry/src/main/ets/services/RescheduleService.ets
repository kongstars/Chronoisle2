import { Task, TaskPriority, TaskStatus, type Subtask } from '../models/Task';
import { DayEvent, DayEventType, ReminderRule, ReminderType } from '../models/DayEvent';
import type { RescheduleItemWithReason, RescheduleResult, RescheduleSplitItem, RescheduleWeekItem } from './AgentService';
import { dataSyncService } from './DataSyncService';
import { db } from '../storage/Database';

const ONE_DAY_MS: number = 24 * 60 * 60 * 1000;
const TOMORROW_TASK_LIMIT: number = 6;

interface RescheduleTaskSummary {
  id: string;
  title: string;
  description: string;
  goalTitle: string;
  krTitle: string;
  priority: string;
  dueDate: string;
  estimatedHours: number;
  delayCount: number;
  isOverdue: boolean;
  hasSubtasks: boolean;
  subtaskTitles: string[];
  reminderId?: string;
  reminderTitle?: string;
  isReminderAutoGenerated: boolean;
  reminderOccurrenceDate?: string;
  reminderEventType?: string;
  reminderRuleTypes?: string[];
  sourceType: string;
  rescheduleDefaultAction: string;
  similarTaskKey: string;
  sameTypeFutureDates: string[];
  possiblePrerequisites: string[];
}

export class RescheduleService {
  public static async loadPendingTasks(context: Context): Promise<Task[]> {
    if (!db.isInitialized()) {
      await db.initialize(context);
    }
    const syncedTasks = dataSyncService.getTasks();
    const sourceTasks = syncedTasks.length > 0 ? syncedTasks : db.getAllTasks();
    return sourceTasks.filter((task: Task) => task.status === TaskStatus.PENDING);
  }

  public static getOverdueTasks(tasks: Task[]): Task[] {
    return tasks
      .filter((task: Task) => task.isOverdue)
      .sort((first: Task, second: Task) => {
        const firstDue = first.dueDate || Number.MAX_SAFE_INTEGER;
        const secondDue = second.dueDate || Number.MAX_SAFE_INTEGER;
        if (firstDue !== secondDue) {
          return firstDue - secondDue;
        }
        return (second.updatedAt || 0) - (first.updatedAt || 0);
      });
  }

  public static getFutureTasks(tasks: Task[]): Task[] {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const upperBound = today.getTime() + 7 * ONE_DAY_MS;
    return tasks
      .filter((task: Task) => {
        if (task.isOverdue || task.dueDate === undefined) {
          return false;
        }
        return task.dueDate >= today.getTime() && task.dueDate <= upperBound;
      })
      .sort((first: Task, second: Task) => (first.dueDate || 0) - (second.dueDate || 0));
  }

  private static buildDayEventMap(): Record<string, DayEvent> {
    const eventMap: Record<string, DayEvent> = {};
    db.getAllDayEvents().forEach((event: DayEvent) => {
      eventMap[event.id] = event;
    });
    return eventMap;
  }

  private static normalizeTaskTitle(title: string): string {
    return title
      .toLowerCase()
      .replace(/[0-9０-９]+/g, '#')
      .replace(/[\s，。,.、:：;；!！?？（）()【】\[\]《》<>“”"']/g, '');
  }

  private static getTaskSimilarityKey(task: Task): string {
    if (task.reminderId && task.reminderId.length > 0) {
      return `reminder:${task.reminderId}`;
    }
    const titleKey = RescheduleService.normalizeTaskTitle(task.title);
    return titleKey.length > 0 ? `title:${titleKey}` : `task:${task.id}`;
  }

  private static formatDate(timestamp: number): string {
    const date = new Date(timestamp);
    return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')}`;
  }

  private static startOfDay(timestamp: number): number {
    const date = new Date(timestamp);
    date.setHours(0, 0, 0, 0);
    return date.getTime();
  }

  private static addDays(timestamp: number, days: number): number {
    return RescheduleService.startOfDay(timestamp) + days * ONE_DAY_MS;
  }

  private static isDailyReminderRule(rule: ReminderRule): boolean {
    return rule.type === ReminderType.PERIODIC_DAILY || rule.type === ReminderType.HABIT_DAILY;
  }

  private static isDailyAutoReminderTask(task: Task, eventMap: Record<string, DayEvent>): boolean {
    if (!task.isReminderAutoGenerated || !task.reminderId) {
      return false;
    }
    const event = eventMap[task.reminderId];
    if (!event) {
      return false;
    }
    return event.type === DayEventType.PERIODIC &&
      event.reminderRules.some((rule: ReminderRule) => RescheduleService.isDailyReminderRule(rule));
  }

  private static isSingleReminderTask(task: Task, eventMap: Record<string, DayEvent>): boolean {
    return !!(task.reminderId && eventMap[task.reminderId]?.type === DayEventType.SINGLE);
  }

  private static isDailyRoutineTask(task: Task, eventMap: Record<string, DayEvent>): boolean {
    if (RescheduleService.isAutoGeneratedPeriodicReminderTask(task, eventMap)) {
      return true;
    }
    if (RescheduleService.isDailyAutoReminderTask(task, eventMap)) {
      return true;
    }
    const event = task.reminderId ? eventMap[task.reminderId] : undefined;
    if (event && event.reminderRules.some((rule: ReminderRule) => RescheduleService.isDailyReminderRule(rule))) {
      return true;
    }
    const text = `${task.title} ${task.reminderTitle || ''}`;
    return /每日|每天|天天|日常|每天都|每日完整/.test(text);
  }

  private static isHabitLikeTask(task: Task, eventMap: Record<string, DayEvent>): boolean {
    if (task.reminderId && eventMap[task.reminderId]?.type === DayEventType.HABIT) {
      return true;
    }
    const text = `${task.title} ${task.goalTitle || ''} ${task.reminderTitle || ''}`;
    return /习惯|打卡|每日|每天|记录|阅读|运动|饮食|学习|冥想|早睡|睡觉|体重/.test(text);
  }

  private static isAutoGeneratedPeriodicReminderTask(task: Task, eventMap: Record<string, DayEvent>): boolean {
    if (!task.isReminderAutoGenerated || !task.reminderId) {
      return false;
    }
    return eventMap[task.reminderId]?.type === DayEventType.PERIODIC;
  }

  private static getSourceType(task: Task, eventMap: Record<string, DayEvent>): string {
    const event = task.reminderId ? eventMap[task.reminderId] : undefined;
    if (task.isReminderAutoGenerated && event?.type === DayEventType.SINGLE) {
      return 'auto_single_reminder';
    }
    if (task.isReminderAutoGenerated && event?.type === DayEventType.PERIODIC) {
      return 'auto_periodic_reminder';
    }
    if (task.isReminderAutoGenerated && event?.type === DayEventType.HABIT) {
      return 'auto_habit_reminder';
    }
    if (task.isReminderAutoGenerated) {
      return 'auto_reminder';
    }
    if (task.aiGenerated) {
      return 'ai_generated';
    }
    return 'manual';
  }

  private static getDefaultRescheduleAction(task: Task, eventMap: Record<string, DayEvent>): string {
    if (RescheduleService.isSingleReminderTask(task, eventMap)) {
      return 'move_together_with_single_reminder';
    }
    if (RescheduleService.isAutoGeneratedPeriodicReminderTask(task, eventMap)) {
      return 'prefer_delete';
    }
    if (RescheduleService.isDailyRoutineTask(task, eventMap)) {
      return 'prefer_delete_or_shelve';
    }
    return 'reschedule_required';
  }

  private static looksLikePrerequisiteTask(task: Task): boolean {
    const text = `${task.title} ${task.description || ''}`;
    return /购买|买|准备|采购|办理|申请|预约|安装|配置|下载|开通|获取|拿到|制定|搭建|创建|注册|学习|先完成/.test(text);
  }

  private static looksBlockedByPrerequisite(task: Task): boolean {
    const text = `${task.title} ${task.description || ''}`;
    return /记录|使用|开始|提交|复盘|测试|测量|称|登记|打卡|执行|练习|上传|填写|分析|统计|整理/.test(text);
  }

  private static hasDependencyTopicOverlap(task: Task, prerequisite: Task): boolean {
    const taskText = `${task.title} ${task.description || ''} ${task.goalTitle || ''}`;
    const prerequisiteText = `${prerequisite.title} ${prerequisite.description || ''} ${prerequisite.goalTitle || ''}`;
    const topicTerms: string[] = [
      '体脂', '体重', '秤', '报告', '证件', '材料', '账号', '环境', '设备', '课程',
      '计划', '表格', '数据', '照片', '合同', '发票', '简历', '论文', '文档', '药',
      '书', '票', '软件', '硬件', '银行卡', '护照', '签证'
    ];
    return topicTerms.some((term: string) => taskText.includes(term) && prerequisiteText.includes(term));
  }

  private static getPossiblePrerequisites(task: Task, tasks: Task[]): string[] {
    if (!RescheduleService.looksBlockedByPrerequisite(task)) {
      return [];
    }
    const hints: string[] = [];
    tasks.forEach((candidate: Task) => {
      if (candidate.id === task.id || candidate.status === TaskStatus.COMPLETED) {
        return;
      }
      if (!RescheduleService.looksLikePrerequisiteTask(candidate)) {
        return;
      }
      if (!RescheduleService.hasDependencyTopicOverlap(task, candidate)) {
        return;
      }
      hints.push(`${candidate.id}:${candidate.title}`);
    });
    return hints.slice(0, 3);
  }

  private static getSameTypeFutureDates(task: Task, tasks: Task[]): string[] {
    const key = RescheduleService.getTaskSimilarityKey(task);
    const today = RescheduleService.startOfDay(Date.now());
    const dates: string[] = [];
    tasks.forEach((item: Task) => {
      if (item.id === task.id || RescheduleService.getTaskSimilarityKey(item) !== key) {
        return;
      }
      const timestamp = item.reminderOccurrenceTime || item.dueDate;
      if (timestamp === undefined || timestamp < today) {
        return;
      }
      const dateText = RescheduleService.formatDate(timestamp);
      if (!dates.includes(dateText)) {
        dates.push(dateText);
      }
    });
    return dates.slice(0, 5);
  }

  private static getLatestSimilarTimestamp(task: Task, tasks: Task[]): number | undefined {
    const key = RescheduleService.getTaskSimilarityKey(task);
    let latest: number | undefined = undefined;
    tasks.forEach((item: Task) => {
      if (item.id === task.id || RescheduleService.getTaskSimilarityKey(item) !== key) {
        return;
      }
      const timestamp = item.reminderOccurrenceTime || item.dueDate;
      if (timestamp === undefined) {
        return;
      }
      if (latest === undefined || timestamp > latest) {
        latest = timestamp;
      }
    });
    return latest;
  }

  private static formatTaskSummary(task: Task, eventMap: Record<string, DayEvent>, allTasks: Task[]): RescheduleTaskSummary {
    const event = task.reminderId ? eventMap[task.reminderId] : undefined;
    return {
      id: task.id,
      title: task.title,
      description: task.description || '',
      goalTitle: task.goalTitle || '',
      krTitle: task.krTitle || '',
      priority: task.priority,
      dueDate: task.deadline || 'no_deadline',
      estimatedHours: task.estimatedHours || 0.5,
      delayCount: task.delayCount || 0,
      isOverdue: task.isOverdue,
      hasSubtasks: !!(task.subtasks && task.subtasks.length > 0),
      subtaskTitles: (task.subtasks || []).map((subtask: Subtask) => subtask.title),
      reminderId: task.reminderId,
      reminderTitle: task.reminderTitle,
      isReminderAutoGenerated: task.isReminderAutoGenerated,
      reminderOccurrenceDate: task.reminderOccurrenceTime ? RescheduleService.formatDate(task.reminderOccurrenceTime) : undefined,
      reminderEventType: event?.type,
      reminderRuleTypes: event ? event.reminderRules.map((rule: ReminderRule) => rule.type) : [],
      sourceType: RescheduleService.getSourceType(task, eventMap),
      rescheduleDefaultAction: RescheduleService.getDefaultRescheduleAction(task, eventMap),
      similarTaskKey: RescheduleService.getTaskSimilarityKey(task),
      sameTypeFutureDates: RescheduleService.getSameTypeFutureDates(task, allTasks),
      possiblePrerequisites: RescheduleService.getPossiblePrerequisites(task, allTasks)
    };
  }

  public static buildOverdueTasksSummary(tasks: Task[]): string {
    const eventMap = RescheduleService.buildDayEventMap();
    const allTasks = db.getAllTasks();
    const payload = tasks.map((task: Task) => RescheduleService.formatTaskSummary(task, eventMap, allTasks));
    return JSON.stringify(payload);
  }

  public static buildFutureTasksSummary(tasks: Task[]): string {
    const eventMap = RescheduleService.buildDayEventMap();
    const allTasks = db.getAllTasks();
    const payload = tasks.map((task: Task) => RescheduleService.formatTaskSummary(task, eventMap, allTasks));
    return JSON.stringify(payload);
  }

  public static countSuggestedActions(result: RescheduleResult, includeDeleteTasks: boolean): number {
    const taskIds: string[] = [];
    const markTask = (taskId: string): void => {
      if (!taskIds.includes(taskId)) {
        taskIds.push(taskId);
      }
    };

    (result.tomorrowTasks || []).forEach((item: RescheduleItemWithReason) => markTask(item.id));
    (result.thisWeekTasks || []).forEach((item: RescheduleWeekItem) => markTask(item.id));
    (result.downgradeTasks || []).forEach((item: RescheduleItemWithReason) => markTask(item.id));
    (result.splitTasks || []).forEach((item: RescheduleSplitItem) => markTask(item.id));
    (result.shelveTasks || []).forEach((item: RescheduleItemWithReason) => markTask(item.id));
    if (includeDeleteTasks) {
      (result.deleteTasks || []).forEach((item: RescheduleItemWithReason) => markTask(item.id));
    }
    return taskIds.length;
  }

  private static markDateOccupancy(occupancy: Record<string, string[]>, timestamp: number, task: Task): void {
    const dateKey = RescheduleService.formatDate(timestamp);
    const taskKey = RescheduleService.getTaskSimilarityKey(task);
    const list = occupancy[dateKey] || [];
    if (!list.includes(taskKey)) {
      list.push(taskKey);
    }
    occupancy[dateKey] = list;
  }

  private static isDateOccupied(occupancy: Record<string, string[]>, timestamp: number, task: Task): boolean {
    const dateKey = RescheduleService.formatDate(timestamp);
    const taskKey = RescheduleService.getTaskSimilarityKey(task);
    return (occupancy[dateKey] || []).includes(taskKey);
  }

  private static buildDateOccupancy(tasks: Task[]): Record<string, string[]> {
    const occupancy: Record<string, string[]> = {};
    const today = RescheduleService.startOfDay(Date.now());
    tasks.forEach((task: Task) => {
      const timestamp = task.reminderOccurrenceTime || task.dueDate;
      if (timestamp === undefined || timestamp < today || task.status === TaskStatus.COMPLETED) {
        return;
      }
      RescheduleService.markDateOccupancy(occupancy, timestamp, task);
    });
    return occupancy;
  }

  private static getSafeScheduledDate(
    task: Task,
    allTasks: Task[],
    occupancy: Record<string, string[]>,
    requestedTimestamp: number
  ): number {
    let nextTimestamp = RescheduleService.startOfDay(requestedTimestamp);
    const latestSimilarTimestamp = RescheduleService.getLatestSimilarTimestamp(task, allTasks);
    if (latestSimilarTimestamp !== undefined &&
      RescheduleService.startOfDay(latestSimilarTimestamp) >= nextTimestamp) {
      nextTimestamp = RescheduleService.addDays(latestSimilarTimestamp, 1);
    }

    let guard = 0;
    while (RescheduleService.isDateOccupied(occupancy, nextTimestamp, task) && guard < 30) {
      nextTimestamp = RescheduleService.addDays(nextTimestamp, 1);
      guard += 1;
    }
    RescheduleService.markDateOccupancy(occupancy, nextTimestamp, task);
    return nextTimestamp;
  }

  private static createDeleteReason(task: Task): string {
    if (task.isReminderAutoGenerated) {
      return '这是周期提醒自动生成的过期任务，错过后不需要补做，清理后会保留后续提醒。';
    }
    return '同类任务已经堆积，继续补做价值较低，建议清理。';
  }

  private static addDeleteTask(result: RescheduleResult, task: Task, assignedTaskIds: string[]): void {
    result.deleteTasks = result.deleteTasks || [];
    if (!result.deleteTasks.some((item: RescheduleItemWithReason) => item.id === task.id)) {
      result.deleteTasks.push({
        id: task.id,
        reason: RescheduleService.createDeleteReason(task)
      });
    }
    if (!assignedTaskIds.includes(task.id)) {
      assignedTaskIds.push(task.id);
    }
  }

  private static addThisWeekTask(
    result: RescheduleResult,
    task: Task,
    reason: string,
    allTasks: Task[],
    occupancy: Record<string, string[]>,
    requestedTimestamp: number,
    assignedTaskIds: string[]
  ): void {
    const safeDate = RescheduleService.getSafeScheduledDate(task, allTasks, occupancy, requestedTimestamp);
    result.thisWeekTasks = result.thisWeekTasks || [];
    result.thisWeekTasks.push({
      id: task.id,
      newDate: RescheduleService.formatDate(safeDate),
      reason
    });
    if (!assignedTaskIds.includes(task.id)) {
      assignedTaskIds.push(task.id);
    }
  }

  public static normalizeResult(result: RescheduleResult, tasks: Task[]): RescheduleResult {
    const eventMap = RescheduleService.buildDayEventMap();
    const taskMap: Record<string, Task> = {};
    tasks.forEach((task: Task) => {
      taskMap[task.id] = task;
    });

    const normalized: RescheduleResult = {
      tomorrowTasks: [],
      thisWeekTasks: [],
      downgradeTasks: [],
      splitTasks: [],
      shelveTasks: [],
      deleteTasks: [],
      summary: result.summary,
      errorMsg: result.errorMsg
    };
    const assignedTaskIds: string[] = [];
    const occupancy = RescheduleService.buildDateOccupancy(tasks);
    const tomorrow = RescheduleService.getTomorrowTimestamp();
    const afterTomorrow = RescheduleService.addDays(tomorrow, 1);

    const shouldSkip = (taskId: string): boolean => assignedTaskIds.includes(taskId) || taskMap[taskId] === undefined;

    (result.deleteTasks || []).forEach((item: RescheduleItemWithReason) => {
      if (shouldSkip(item.id)) {
        return;
      }
      const task = taskMap[item.id];
      normalized.deleteTasks!.push(item);
      assignedTaskIds.push(task.id);
    });

    (result.tomorrowTasks || []).forEach((item: RescheduleItemWithReason) => {
      if (shouldSkip(item.id)) {
        return;
      }
      const task = taskMap[item.id];
      if (RescheduleService.isDailyRoutineTask(task, eventMap)) {
        RescheduleService.addDeleteTask(normalized, task, assignedTaskIds);
        return;
      }
      if (RescheduleService.isHabitLikeTask(task, eventMap) ||
        normalized.tomorrowTasks!.length >= TOMORROW_TASK_LIMIT ||
        RescheduleService.isDateOccupied(occupancy, tomorrow, task)) {
        RescheduleService.addThisWeekTask(
          normalized,
          task,
          `${item.reason}。为避免明天继续堆积，已错峰到同类任务之后。`,
          tasks,
          occupancy,
          afterTomorrow,
          assignedTaskIds
        );
        return;
      }
      normalized.tomorrowTasks!.push(item);
      RescheduleService.markDateOccupancy(occupancy, tomorrow, task);
      assignedTaskIds.push(task.id);
    });

    (result.thisWeekTasks || []).forEach((item: RescheduleWeekItem) => {
      if (shouldSkip(item.id)) {
        return;
      }
      const task = taskMap[item.id];
      if (RescheduleService.isDailyRoutineTask(task, eventMap)) {
        RescheduleService.addDeleteTask(normalized, task, assignedTaskIds);
        return;
      }
      const parsedDate = RescheduleService.parseDateStringToTimestamp(item.newDate) || afterTomorrow;
      const requestedDate = parsedDate <= tomorrow ? afterTomorrow : parsedDate;
      RescheduleService.addThisWeekTask(
        normalized,
        task,
        item.reason,
        tasks,
        occupancy,
        requestedDate,
        assignedTaskIds
      );
    });

    (result.downgradeTasks || []).forEach((item: RescheduleItemWithReason) => {
      if (shouldSkip(item.id)) {
        return;
      }
      const task = taskMap[item.id];
      if (RescheduleService.isDailyRoutineTask(task, eventMap)) {
        RescheduleService.addDeleteTask(normalized, task, assignedTaskIds);
        return;
      }
      normalized.downgradeTasks!.push(item);
      assignedTaskIds.push(item.id);
    });

    (result.splitTasks || []).forEach((item: RescheduleSplitItem) => {
      if (shouldSkip(item.id)) {
        return;
      }
      const task = taskMap[item.id];
      if (RescheduleService.isDailyRoutineTask(task, eventMap)) {
        RescheduleService.addDeleteTask(normalized, task, assignedTaskIds);
        return;
      }
      normalized.splitTasks!.push(item);
      assignedTaskIds.push(item.id);
    });

    (result.shelveTasks || []).forEach((item: RescheduleItemWithReason) => {
      if (shouldSkip(item.id)) {
        return;
      }
      const task = taskMap[item.id];
      if (RescheduleService.isDailyRoutineTask(task, eventMap)) {
        RescheduleService.addDeleteTask(normalized, task, assignedTaskIds);
        return;
      }
      normalized.shelveTasks!.push(item);
      assignedTaskIds.push(item.id);
    });

    tasks.forEach((task: Task) => {
      if (!task.isOverdue || assignedTaskIds.includes(task.id)) {
        return;
      }
      if (RescheduleService.isDailyRoutineTask(task, eventMap)) {
        RescheduleService.addDeleteTask(normalized, task, assignedTaskIds);
        return;
      }
      RescheduleService.addThisWeekTask(
        normalized,
        task,
        'AI 未覆盖该逾期任务，已默认顺延到本周稍后，确保所有逾期任务都有处理建议。',
        tasks,
        occupancy,
        afterTomorrow,
        assignedTaskIds
      );
    });

    return normalized;
  }

  public static parseDateStringToTimestamp(dateText: string): number | undefined {
    const normalized = dateText.trim();
    if (!normalized) {
      return undefined;
    }
    const parsedDate = new Date(normalized.replace(/-/g, '/'));
    if (isNaN(parsedDate.getTime())) {
      return undefined;
    }
    parsedDate.setHours(0, 0, 0, 0);
    return parsedDate.getTime();
  }

  public static getTomorrowTimestamp(): number {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    tomorrow.setHours(0, 0, 0, 0);
    return tomorrow.getTime();
  }

  private static lowerPriority(priority: TaskPriority): TaskPriority {
    if (priority === TaskPriority.HIGH) {
      return TaskPriority.NORMAL;
    }
    return TaskPriority.LOW;
  }

  private static createSubtask(title: string): Subtask {
    return {
      id: `subtask_${Date.now()}_${Math.random().toString(36).substring(2, 8)}`,
      title: title,
      isCompleted: false
    };
  }

  private static applyMove(task: Task, timestamp: number): boolean {
    const nextDelayCount = (task.delayCount || 0) + 1;
    const dueChanged = task.dueDate !== timestamp;
    const delayChanged = nextDelayCount !== (task.delayCount || 0);
    task.dueDate = timestamp;
    task.delayCount = nextDelayCount;
    return dueChanged || delayChanged;
  }

  private static async syncSingleReminderMove(task: Task, eventMap: Record<string, DayEvent>, timestamp: number): Promise<void> {
    if (!task.reminderId) {
      return;
    }
    const event = eventMap[task.reminderId];
    if (!event || event.type !== DayEventType.SINGLE) {
      return;
    }
    const previousTargetDate = event.targetDate || event.startDate;
    if (RescheduleService.startOfDay(previousTargetDate) === RescheduleService.startOfDay(timestamp)) {
      return;
    }
    event.targetDate = RescheduleService.startOfDay(timestamp);
    if (event.isCompleted) {
      event.isCompleted = false;
    }
    if (!event.isEnabled) {
      event.isEnabled = true;
    }
    if (event.skipOnceUntil !== undefined) {
      event.skipOnceUntil = undefined;
    }
    await db.updateDayEvent(event);
    eventMap[event.id] = event;
  }

  private static applyShelve(task: Task): boolean {
    const previousDueDate = task.dueDate;
    const previousDueTime = task.dueTime;
    const previousPriority = task.priority;
    const previousImportant = task.isImportant;
    task.dueDate = undefined;
    task.dueTime = undefined;
    task.priority = TaskPriority.LOW;
    task.isImportant = false;
    task.delayCount = (task.delayCount || 0) + 1;
    return previousDueDate !== undefined ||
      previousDueTime !== undefined ||
      previousPriority !== task.priority ||
      previousImportant !== task.isImportant;
  }

  private static applyDowngrade(task: Task): boolean {
    const nextPriority = RescheduleService.lowerPriority(task.priority);
    const changed = nextPriority !== task.priority || task.isImportant;
    task.priority = nextPriority;
    if (nextPriority !== TaskPriority.HIGH) {
      task.isImportant = false;
    }
    return changed;
  }

  private static applySplit(task: Task, splitItem: RescheduleSplitItem): boolean {
    task.subtasks = task.subtasks || [];
    const existingTitles = task.subtasks.map((item: Subtask) => item.title.trim());
    let addedCount = 0;
    splitItem.subTasks.forEach((title: string) => {
      const normalized = title.trim();
      if (!normalized || existingTitles.includes(normalized)) {
        return;
      }
      task.subtasks.push(RescheduleService.createSubtask(normalized));
      existingTitles.push(normalized);
      addedCount += 1;
    });
    return addedCount > 0;
  }

  public static async applyResult(
    context: Context,
    result: RescheduleResult,
    includeDeleteTasks: boolean
  ): Promise<number> {
    if (!db.isInitialized()) {
      await db.initialize(context);
    }

    const latestTasks = db.getAllTasks();
    const taskMap: Record<string, Task> = {};
    latestTasks.forEach((task: Task) => {
      taskMap[task.id] = task;
    });
    const eventMap = RescheduleService.buildDayEventMap();

    const appliedTaskIds: string[] = [];
    const hasApplied = (taskId: string): boolean => appliedTaskIds.includes(taskId);
    const markApplied = (taskId: string): void => {
      if (!appliedTaskIds.includes(taskId)) {
        appliedTaskIds.push(taskId);
      }
    };

    for (const item of (result.tomorrowTasks || [])) {
      const task = taskMap[item.id];
      if (!task || hasApplied(item.id)) {
        continue;
      }
      if (RescheduleService.applyMove(task, RescheduleService.getTomorrowTimestamp())) {
        await db.updateTask(task);
        await RescheduleService.syncSingleReminderMove(task, eventMap, RescheduleService.getTomorrowTimestamp());
        markApplied(task.id);
      }
    }

    for (const item of (result.thisWeekTasks || [])) {
      const task = taskMap[item.id];
      const nextDate = RescheduleService.parseDateStringToTimestamp(item.newDate);
      if (!task || nextDate === undefined || hasApplied(item.id)) {
        continue;
      }
      if (RescheduleService.applyMove(task, nextDate)) {
        await db.updateTask(task);
        await RescheduleService.syncSingleReminderMove(task, eventMap, nextDate);
        markApplied(task.id);
      }
    }

    for (const item of (result.downgradeTasks || [])) {
      const task = taskMap[item.id];
      if (!task || hasApplied(item.id)) {
        continue;
      }
      if (RescheduleService.applyDowngrade(task)) {
        await db.updateTask(task);
        markApplied(task.id);
      }
    }

    for (const item of (result.splitTasks || [])) {
      const task = taskMap[item.id];
      if (!task || hasApplied(item.id)) {
        continue;
      }
      if (RescheduleService.applySplit(task, item)) {
        await db.updateTask(task);
        markApplied(task.id);
      }
    }

    for (const item of (result.shelveTasks || [])) {
      const task = taskMap[item.id];
      if (!task || hasApplied(item.id)) {
        continue;
      }
      if (RescheduleService.applyShelve(task)) {
        await db.updateTask(task);
        markApplied(task.id);
      }
    }

    for (const item of (result.deleteTasks || [])) {
      const task = taskMap[item.id];
      if (!task || hasApplied(item.id)) {
        continue;
      }
      const shouldAutoClean = RescheduleService.isDailyAutoReminderTask(task, eventMap);
      if (!includeDeleteTasks && !shouldAutoClean) {
        continue;
      }
      await db.deleteTask(item.id);
      markApplied(item.id);
    }

    return appliedTaskIds.length;
  }
}
