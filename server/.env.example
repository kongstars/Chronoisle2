# Alibaba Cloud Credentials
# DO NOT commit actual credentials to version control!
# Copy this file to .env and fill in your actual credentials

ALIBABA_CLOUD_ACCESS_KEY_ID=你的AccessKey ID
ALIBABA_CLOUD_ACCESS_KEY_SECRET=你的AccessKey Secret
ALIBABA_CLOUD_REGION=cn-shanghai
ALIBABA_CLOUD_SPEECH_APP_KEY=你的语音服务AppKey

# 阿里云百炼 Agent API keys (用于 AI 任务解析)
ALIBABA_CLOUD_BAILIAN_API_KEY=你的百炼API_KEY
ALIBABA_CLOUD_BAILIAN_APP_ID=你的百炼智能体应用APP_ID

# DeepSeek (用于 AI 目标规划工作流)
DEEPSEEK_API_KEY=你的DeepSeek_API_KEY
DEEPSEEK_MODEL=deepseek-chat

# Goal Planning Model Routing
# 是否记录 AI 目标拆解全过程 trace；默认开启，便于持续优化
GOAL_PLANNING_TRACE_ENABLED=true
# 重质量链路默认模型：用于难度评估、进度追踪、任务拆解等核心规划
GOAL_PLANNING_MODEL=qwen3-max
# 快速链路默认模型：用于目标理解、AI追问、Critic 等速度敏感节点
GOAL_PLANNING_FAST_MODEL=qwen-plus-latest
# 如需单独覆盖，可按 agent 继续细分；未设置时会自动回退到上面的默认值
# GOAL_PLANNING_GOAL_DEFINER_MODEL=qwen-plus-latest
# GOAL_PLANNING_CLARIFY_MODEL=qwen-plus-latest
# GOAL_PLANNING_CRITIC_MODEL=qwen-plus-latest
# GOAL_PLANNING_DIFFICULTY_MODEL=qwen3-max
# GOAL_PLANNING_PROGRESS_MODEL=qwen3-max
# GOAL_PLANNING_TASK_PLANNER_MODEL=qwen3-max
# GOAL_PLANNING_TASK_ATOMIZER_MODEL=qwen3-max
# Goal Planning Timeouts
GOAL_PLANNING_HTTP_TIMEOUT_MS=900000
GOAL_PLANNING_TIMEOUT_MS=300000
GOAL_PLANNING_PROGRESS_CRITIC_TIMEOUT_MS=60000
GOAL_PLANNING_ACTION_CRITIC_TIMEOUT_MS=60000

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080

# Security
JWT_SECRET=你的JWT密钥（用于可选的身份验证）
TOKEN_CACHE_TTL=3600  # Token缓存时间（秒），阿里云Token通常24小时有效

# Rate Limiting (optional)
# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000  # 15分钟
RATE_LIMIT_MAX_REQUESTS=100  # 每15分钟最多100次请求

# Huawei IAP Configuration
HUAWEI_PAY_CLIENT_ID=你的AppGalleryConnect_Client_ID
HUAWEI_PAY_CLIENT_SECRET=你的AppGalleryConnect_Client_Secret
HUAWEI_IAP_PUBLIC_KEY=你的IAP_RSA公钥或PEM公钥
HUAWEI_IAP_APP_ID=你的AppGalleryConnect_APP_ID
HUAWEI_IAP_ISSUER_ID=你的AppGalleryConnect_Issuer_ID
HUAWEI_IAP_KEY_ID=你的AppGalleryConnect服务端密钥ID
HUAWEI_IAP_PRIVATE_KEY_PATH=服务器上的p8私钥绝对路径
HUAWEI_IAP_USE_SERVER_API=true
HUAWEI_IAP_ROOT_URL=https://iap.cloud.huawei.com
HUAWEI_IAP_PRODUCTION_NOTIFY_URL=https://sishiqingdan.cn/api/iap/huawei/notify
HUAWEI_IAP_SANDBOX_NOTIFY_URL=https://test-api.sishiqingdan.cn/api/iap/huawei/notify
